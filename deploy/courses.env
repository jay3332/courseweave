# Settings for the personal instance; secrets go in secrets.env on the server, never here. Paths are relative to
# ~/courses (the service's working directory).
APP_URL=https://courses.jay3332.tech
HOST=127.0.0.1
PORT=8130
STATIC_DIR=site
CATALOG_DIR=catalog
USER_DB_PATH=data/users.sqlite
RUST_LOG=info

# Google, limited to verified CMU emails by the server; the same OAuth client as Courseweave.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=197877729931-0b9jqhhp1h5rjipdi0lhh8oreuciso45.apps.googleusercontent.com
OAUTH_RELAY_URL=https://courses.jay3332.tech/auth/callback

# Courseweave's syllabi in R2, at the bucket's root.
SYLLABI_BUCKET=courseweave-syllabi
SYLLABI_S3_REGION=auto
SYLLABI_PREFIX=
