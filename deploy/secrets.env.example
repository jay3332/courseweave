# ~/courses/secrets.env on the server (chmod 600). Fill in every value, then: systemctl --user restart courses
# Courseweave's Google OAuth client secret (GCP console > APIs & Services > Credentials).
OIDC_CLIENT_SECRET=
# An R2 API token with read access to courseweave-syllabi (its S3 access key ID and secret).
SYLLABI_ACCESS_KEY_ID=
SYLLABI_SECRET_ACCESS_KEY=
