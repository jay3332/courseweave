// Cloudflare Workers deployment: the built site (dist/) is served as static assets; worker/ handles CMU sign-in,
// synced data (D1) and the FCE gate. Setup and deploy steps: README, "Deploying to Cloudflare".
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courseweave",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  // Served at courseweave.jay3332.tech (the zone is on this Cloudflare account; deploy creates the DNS record and
  // certificate). The workers.dev address is off so there's one canonical URL for sign-in redirects.
  "routes": [{ "pattern": "courseweave.jay3332.tech", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/S27/schedule, …) get index.html. The app's data loaders treat that HTML fallback as a
    // missing file, so public /data files stay free, uncounted static asset requests.
    "not_found_handling": "single-page-application",
    // These always go through the Worker (each counts as an invocation), even when a matching file exists:
    // FCE files are only served to signed-in CMU users.
    "run_worker_first": ["/api/*", "/auth/*", "/data/fce/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "courseweave",
      // Created with `npx wrangler d1 create courseweave`; tables via `npm run db:migrate:remote`.
      "database_id": "02810954-8da5-4f1c-a05f-64d31048fc81",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // OpenID Connect provider. Google, limited to CMU accounts by ALLOWED_EMAIL_DOMAINS, is the default.
    "OIDC_ISSUER": "https://accounts.google.com",
    // Your OAuth client id. Empty = sign-in off: /auth/login returns 503, FCE stays locked and isn't deployed.
    // The client secret and SESSION_SECRET are secrets: `npx wrangler secret put OIDC_CLIENT_SECRET` etc.
    "OIDC_CLIENT_ID": "",
    "ALLOWED_EMAIL_DOMAINS": "andrew.cmu.edu,cmu.edu",
  },
  "observability": { "enabled": true },
}
