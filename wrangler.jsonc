// Cloudflare Workers deployment: the built site (dist/) is served as static assets; worker/ handles CMU sign-in,
// synced data (D1) and the FCE gate. Setup and deploy steps: README, "Deploying to Cloudflare".
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courseweave",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  // Served at courseweave.jay3332.tech (the zone is on this Cloudflare account; deploy creates the DNS record and
  // certificate). The workers.dev address is off so there's one canonical URL for sign-in redirects.
  "routes": [{ "pattern": "courseweave.jay3332.tech", "custom_domain": true }],
  "workers_dev": false,
  // `wrangler dev` would otherwise present requests as coming from the custom domain above, breaking local sign-in
  // (redirect URI), cookie names and the dev-origin check. Locally the Worker sees http://localhost:8787.
  "dev": { "host": "localhost:8787" },
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/S27/schedule, …) get index.html. The app's data loaders treat that HTML fallback as a
    // missing file, so public /data files stay free, uncounted static asset requests.
    "not_found_handling": "single-page-application",
    // These always go through the Worker (each counts as an invocation), even when a matching file exists:
    // FCE files and the syllabus index are only served to signed-in CMU users.
    "run_worker_first": ["/api/*", "/auth/*", "/data/fce/*", "/data/syllabi/*"],
  },
  // Past syllabi (CMU-internal; the Worker serves them to signed-in CMU users at /api/syllabi/<key>). Created with
  // `npx wrangler r2 bucket create courseweave-syllabi`; filled with `node scripts/upload-syllabi.ts --remote`.
  "r2_buckets": [{ "binding": "SYLLABI", "bucket_name": "courseweave-syllabi" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "courseweave",
      // Created with `npx wrangler d1 create courseweave`; tables via `npm run db:migrate:remote`.
      "database_id": "02810954-8da5-4f1c-a05f-64d31048fc81",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // OpenID Connect provider. Google, limited to CMU accounts by ALLOWED_EMAIL_DOMAINS, is the default.
    "OIDC_ISSUER": "https://accounts.google.com",
    // Your OAuth client id. Empty = sign-in off: /auth/login returns 503, FCE stays locked and isn't deployed.
    // The client secret and SESSION_SECRET are secrets: `npx wrangler secret put OIDC_CLIENT_SECRET` etc.
    "OIDC_CLIENT_ID": "197877729931-0b9jqhhp1h5rjipdi0lhh8oreuciso45.apps.googleusercontent.com",
    "ALLOWED_EMAIL_DOMAINS": "andrew.cmu.edu,cmu.edu",
  },
  // Per-location burst limits (Workers Rate Limiting; period must be 10 or 60 s). They protect D1 and Google from
  // floods; requests over a limit get 429 with Retry-After. Daily totals are capped by the per-document write cap
  // in D1 and by the zone WAF rule in the README. namespace_ids are account-wide, so keep them unique.
  "ratelimits": [
    // Every /api, /auth and /data/fce request, per client IP.
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // Sign-in start and callback (each calls Google), per client IP.
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Sync writes and account deletion, per signed-in account.
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
  ],
  // Daily at 04:17 UTC: delete expired sessions (worker/index.ts `scheduled`).
  "triggers": { "crons": ["17 4 * * *"] },
  // Query strings (the OAuth code/state on /auth/callback) are kept out of logs and traces.
  "observability": { "enabled": true, "redact_query_string": true },
}
